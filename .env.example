# Estas variables se configuran en el servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Requerida para crear usuarios desde Turno. No usar el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Token del checador de esta instalación. Se genera con el SQL del README.
TURNO_KIOSK_TOKEN=

# QR por turno. Define el secreto de la tarea y configura uno o ambos medios de envío.
TURNO_QR_JOB_SECRET=
# Puerto de Turno para la tarea local. Si se omite, usa 3000.
TURNO_QR_LOCAL_PORT=3000
RESEND_API_KEY=
TURNO_QR_FROM_EMAIL=
TURNO_WHATSAPP_ACCESS_TOKEN=
TURNO_WHATSAPP_PHONE_NUMBER_ID=
TURNO_WHATSAPP_GRAPH_VERSION=
TURNO_WHATSAPP_QR_TEMPLATE=
TURNO_WHATSAPP_QR_LANGUAGE=es_MX
